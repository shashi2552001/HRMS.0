{
  "entities": {
    "StaffUser": {
      "title": "StaffUser",
      "description": "Internal 9HR India staff account metadata (Super Admin, Admin, HR/Recruiter) synced with Firebase Auth.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["SUPER_ADMIN", "ADMIN", "HR"]
        },
        "department": {
          "type": "string",
          "maxLength": 80
        },
        "isActive": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "fullName", "role", "isActive", "createdAt", "updatedAt"]
    },
    "AdminGrant": {
      "title": "AdminGrant",
      "description": "Trusted role lookup record granting Admin or Super Admin privileges.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "role": {
          "type": "string",
          "enum": ["SUPER_ADMIN", "ADMIN"]
        },
        "grantedBy": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "role", "grantedBy", "createdAt"]
    },
    "CandidateSummary": {
      "title": "CandidateSummary",
      "description": "Synced candidate onboarding record owned by assigned HR/Admin staff.",
      "type": "object",
      "properties": {
        "candidateCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "mobile": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20
        },
        "position": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "joiningDate": {
          "type": "string",
          "maxLength": 30
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Link Sent",
            "In Progress",
            "Submitted",
            "Under Review",
            "Documents Pending",
            "Correction Required",
            "Approved",
            "Onboarding Completed",
            "Rejected"
          ]
        },
        "completionPct": {
          "type": "number"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isDemo": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "candidateCode",
        "fullName",
        "email",
        "mobile",
        "position",
        "department",
        "joiningDate",
        "status",
        "completionPct",
        "ownerId",
        "isDemo",
        "createdAt",
        "updatedAt"
      ]
    },
    "EmployeeRecord": {
      "title": "EmployeeRecord",
      "description": "Approved employee record converted from candidate onboarding.",
      "type": "object",
      "properties": {
        "employeeCode": {
          "type": "string",
          "minLength": 5,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "candidateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "position": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "joiningDate": {
          "type": "string",
          "maxLength": 30
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isDemo": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "employeeCode",
        "candidateId",
        "fullName",
        "email",
        "department",
        "position",
        "joiningDate",
        "ownerId",
        "isDemo",
        "createdAt",
        "updatedAt"
      ]
    },
    "AuditLogEntry": {
      "title": "AuditLogEntry",
      "description": "Immutable security and onboarding audit log entry.",
      "type": "object",
      "properties": {
        "actorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorEmail": {
          "type": "string",
          "maxLength": 200
        },
        "action": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "targetType": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "details": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["actorUid", "actorEmail", "action", "targetType", "targetId", "details", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/StaffUser" },
      "description": "Internal HR/Admin/Super Admin staff profiles isolated by owner UID and admin access."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminGrant" },
      "description": "Trusted admin role grants checked by isAdmin()."
    },
    "/candidates/{candidateId}": {
      "schema": { "$ref": "#/entities/CandidateSummary" },
      "description": "Candidate onboarding summary records scoped by recruiter ownerId or admin."
    },
    "/employees/{employeeId}": {
      "schema": { "$ref": "#/entities/EmployeeRecord" },
      "description": "Converted employee records linked atomically to candidates."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLogEntry" },
      "description": "Immutable audit log entries."
    }
  }
}
